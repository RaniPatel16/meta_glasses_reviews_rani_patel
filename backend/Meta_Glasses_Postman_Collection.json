{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-1234-56789abcdef0",
		"name": "Meta Glasses Reviews API",
		"description": "Comprehensive Postman collection covering Authentication, User Management, and Review Aggregation for the Meta Glasses project.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"password\": \"Password123!\",\n    \"role\": \"user\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/v1/auth/register",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "v1", "auth", "register"]
						}
					}
				},
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"john@example.com\",\n    \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/v1/auth/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "v1", "auth", "login"]
						}
					}
				},
				{
					"name": "Get Current User Profile",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "http://localhost:5000/api/v1/profile",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "v1", "profile"]
						}
					}
				}
			]
		},
		{
			"name": "2. Reviews (CRUD & Advanced)",
			"item": [
				{
					"name": "Get All Reviews (with Pagination & Filters)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:5000/api/v1/reviews?limit=10&page=1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "v1", "reviews"],
							"query": [
								{ "key": "limit", "value": "10" },
								{ "key": "page", "value": "1" }
							]
						}
					}
				},
				{
					"name": "Get Highest Rated Reviews (Aggregation)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:5000/api/v1/reviews/top/highest-rated",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "v1", "reviews", "top", "highest-rated"]
						}
					}
				},
				{
					"name": "Create Review",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reviewID\": \"rev-001\",\n    \"name\": \"Jane Doe\",\n    \"title\": \"Amazing Glasses\",\n    \"review\": \"These are the best smart glasses ever.\",\n    \"rating\": 5,\n    \"country\": \"United States\",\n    \"date\": \"2026-06-12\"\n}"
						},
						"url": {
							"raw": "http://localhost:5000/api/v1/reviews",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "v1", "reviews"]
						}
					}
				},
				{
					"name": "Search Reviews",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:5000/api/v1/reviews/search?q=battery",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "v1", "reviews", "search"],
							"query": [
								{ "key": "q", "value": "battery" }
							]
						}
					}
				}
			]
		},
		{
			"name": "3. System & Utilities",
			"item": [
				{
					"name": "Server Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:5000/api/v1/health",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5000",
							"path": ["api", "v1", "health"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "token",
			"value": "your_jwt_token_here",
			"type": "string"
		}
	]
}
